[project ConstraintExtraction]
[server Experimental@localhost:8000]
route GET ExampleRoute {
    code modules {`
        module Extract::example program {
            input vehicle: string;
            input env: string;

            // program code

            if (vehicle == "car") &&
                (env == "air") {
                assert(false);
            }

            // more program code
        }
    `}
}