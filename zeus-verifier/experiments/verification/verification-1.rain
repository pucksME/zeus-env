[project Verification]
[server Experimental@localhost:8000]
route GET ExampleRoute {
    code modules {`
        module Verify::verification example {
            input x: int;
            var y: int = 1;

            while x > 10 {
                x = x - 2;
                if x == 5 {
                    y = y + 1;
                }
            }
            assert y < 2;
        }
    `}
}