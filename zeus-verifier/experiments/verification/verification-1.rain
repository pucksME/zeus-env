[project Verification]
[server Experimental@localhost:8000]
route GET ExampleRoute {
    code modules {`
        module Verify::example program {
            input x: int;
            var y: int = 1;

            while x < 3 {
                x = x + 2;
                if x == 4 {
                    y = y + 1;
                }
            }
            assert y < 2;
        }
    `}
}